          "after_content": "import { cookies, headers } from 'next/headers'\n\nexport default async function Home() {\n  const cookieStore = await cookies()\n  const headerStore = await headers()\n\n  const theme = cookieStore.get('theme')?.value || 'light'\n  const language = headerStore.get('accept-language') || 'not specified'\n\n  return (\n    <main>\n      <h1>User Preferences</h1>\n      <p>\n        Current theme: <span data-testid=\"theme\">{theme}</span>\n      </p>\n      <p>\n        Preferred language: <span data-testid=\"language\">{language}</span>\n      </p>\n    </main>\n  )\n}\n",
