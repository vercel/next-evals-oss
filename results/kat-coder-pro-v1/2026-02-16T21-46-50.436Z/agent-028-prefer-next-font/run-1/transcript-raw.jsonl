ogHeader() {\n   return (\n-    <header>\n-      <h1>My Personal Blog</h1>\n-      <p>Thoughts, ideas, and musings</p>\n+    <header className={`${playfair.variable} ${roboto.variable}`}>\n+      <h1 className=\"font-playfair\">My Personal Blog</h1>\n+      <p className=\"font-roboto\">Thoughts, ideas, and musings</p>\n     </header>\n   );\n }\n","filediff":{"file":"/vercel/sandbox/app/BlogHeader.tsx","before":"export default function BlogHeader() {\n  return (\n    <header>\n      <h1>My Personal Blog</h1>\n      <p>Thoughts, ideas, and musings</p>\n    </header>\n  );\n}\n","after":"'use client';\n\nimport { Playfair_Display } from 'next/font/google';\nimport { Roboto } from 'next/font/google';\n\nconst playfair = Playfair_Display({\n  subsets: ['latin'],\n  weight: ['700'],\n  variable: '--font-playfair',\n});\n\nconst roboto = Roboto({\n  subsets: ['latin'],\n  weight: ['400'],\n  variable: '--font-roboto',\n});\n\nexport default function BlogHeader() {\n  return (\n    <header className={`${playfair.variable} ${roboto.variable}`}>\n      <h1 className=\"font-playfair\">My Personal Blog</h1>\n      <p className=\"font-roboto\">Thoughts, ideas, and musings</p>\n    </header>\n  );\n}\n","additions":20,"deletions":3},"truncated":false},"time":{"start":1771278628107,"end":1771278631126}}}}
