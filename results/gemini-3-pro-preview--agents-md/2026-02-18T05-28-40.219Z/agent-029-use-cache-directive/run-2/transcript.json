        "args": {
          "content": "import { unstable_cache, revalidateTag } from 'next/cache';\nimport { getAllProducts } from '@/lib/db';\n\n// Cache the product fetching with the 'products' tag\nconst getCachedProducts = unstable_cache(\n  async () => getAllProducts(),\n  ['all-products'], // keyParts\n  { tags: ['products'] }\n);\n\nexport default async function Page() {\n  const products = await getCachedProducts();\n\n  async function syncCatalog() {\n    'use server';\n    // Use 'max' profile to allow serving stale data while revalidating in background.\n    // This ensures the admin experience remains responsive even during large sync jobs.\n    revalidateTag('products', 'max'); \n  }\n\n  return (\n    <div className=\"p-8 font-sans\">\n      <h1 className=\"text-2xl font-bold mb-4\">Product Catalog</h1>\n      \n      <div className=\"mb-8 p-6 bg-gray-50 border rounded-lg\">\n        <h2 className=\"text-lg font-semibold mb-4\">Catalog Actions</h2>\n        <form action={syncCatalog} className=\"flex flex-col gap-2 max-w-sm\">\n          <button \n            type=\"submit\"\n            className=\"px-4 py-2 bg-blue-600 text-white font-medium rounded hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2\"\n          >\n            Sync latest catalog\n          </button>\n          <p className=\"text-sm text-gray-500\">\n            Triggers a background refresh. You can continue working immediately.\n          </p>\n        </form>\n      </div>\n\n      <div className=\"bg-white shadow overflow-hidden border-b border-gray-200 sm:rounded-lg\">\n        <table className=\"min-w-full divide-y divide-gray-200\">\n          <thead className=\"bg-gray-50\">\n            <tr>\n              <th scope=\"col\" className=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n                ID\n              </th>\n              <th scope=\"col\" className=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n                Name\n              </th>\n              <th scope=\"col\" className=\"px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n                Price\n              </th>\n            </tr>\n          </thead>\n          <tbody className=\"bg-white divide-y divide-gray-200\">\n            {products.map((product: any) => (\n              <tr key={product.id}>\n                <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\n                  #{product.id}\n                </td>\n                <td className=\"px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900\">\n                  {product.name}\n                </td>\n                <td className=\"px-6 py-4 whitespace-nowrap text-sm text-gray-500\">\n                  ${product.price}\n                </td>\n              </tr>\n            ))}\n          </tbody>\n        </table>\n      </div>\n      \n      <div className=\"mt-4 text-xs text-gray-400 text-right\">\n        Catalog data is cached. Sync to refresh.\n      </div>\n    </div>\n  );\n}\n",
          "file_path": "app/page.tsx",
          "_extractedPath": "app/page.tsx"
        }
