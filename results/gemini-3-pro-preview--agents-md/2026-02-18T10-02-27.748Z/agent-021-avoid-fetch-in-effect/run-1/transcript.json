        "args": {
          "file_path": "app/UserProfile.tsx",
          "old_string": "// TODO: Implement UserProfile component that fetches user data\n// Create an async server component using the existing server component pattern\n// Fetch user data from /api/users/profile and display the name and email\n\nexport default function UserProfile() {\n  return <div>User profile not implemented</div>;\n}",
          "instruction": "Implement the UserProfile component to fetch user data from /api/users/profile and display the name and email. \nUse the async/await pattern for the component and fetch function, similar to how it's done in app/page.tsx.\nInclude error handling that returns mock data if the fetch fails.\nDefine a User interface for type safety.",
          "new_string": "interface User {\n  id: string | number;\n  name: string;\n  email: string;\n}\n\nasync function getUserProfile(): Promise<User> {\n  try {\n    const res = await fetch('/api/users/profile');\n    if (!res.ok) {\n      throw new Error('Failed to fetch user profile');\n    }\n    return res.json();\n  } catch (error) {\n    // Return mock data for build time or error cases\n    return {\n      id: 1,\n      name: 'John Doe',\n      email: 'john@example.com'\n    };\n  }\n}\n\nexport default async function UserProfile() {\n  const user = await getUserProfile();\n\n  return (\n    <div>\n      <h2>User Profile</h2>\n      <div>Name: {user.name}</div>\n      <div>Email: {user.email}</div>\n    </div>\n  );\n}"
