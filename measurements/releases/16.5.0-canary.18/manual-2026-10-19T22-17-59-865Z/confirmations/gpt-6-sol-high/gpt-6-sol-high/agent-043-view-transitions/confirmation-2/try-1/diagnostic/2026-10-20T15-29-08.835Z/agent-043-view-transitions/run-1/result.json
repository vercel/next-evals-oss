ack-link').click();\n    await page.waitForURL('http://127.0.0.1:3100/');\n    await page.waitForTimeout(600);\n    const back = await page.evaluate(() => ({ calls: window.__vtCalls, samples: window.__vtSamples, gridName: getComputedStyle(document.querySelector('.product-image')).viewTransitionName }));\n    console.log(JSON.stringify({ motion, errors, forward: { calls: forward.calls, heroName: forward.heroName, sampleCount: forward.samples.length, sample: forward.samples.find(x => x.pseudoAnimations.length) || forward.samples[0] }, back: { calls: back.calls, gridName: back.gridName, sampleCount: back.samples.length, sample: back.samples.find(x => x.pseudoAnimations.length) || back.samples[0] } }, null, 2));\n    await page.close();\n  }\n  await browser.close();\n})().catch(e => { console.error(e); process.exit(1); });\nEOF\"",
